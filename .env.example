# GROQ_API_KEY: Required for Groq AI API calls (from https://console.groq.com)
GROQ_API_KEY="gsk_..."
GROQ_MODEL="openai/gpt-oss-120b"

# GEMINI_API_KEY (optional fallback)
GEMINI_API_KEY="AQ.Ab8RN6IFf7vJQEcPV3LLTz-Jpul9DCrKGcGUbpTdDe6_MxQWuA"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: If you ever host the Express backend on a separate server (e.g. Render, Railway),
# set this to your backend domain (e.g. "https://api.yourdomain.com").
# Leave blank when deploying everything together on Vercel.
VITE_API_BASE_URL=""

